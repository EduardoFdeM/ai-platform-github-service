DEBUG=true
DJANGO_SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
POSTGRES_DB=github_sync
POSTGRES_USER=github_sync
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
GITHUB_API_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT=10
GITHUB_MAX_RETRY_AFTER=60
GITHUB_REQUIRED_SCOPES=
GITHUB_ALLOWED_SCOPES=repo,repo:status,read:org
GITHUB_COMMIT_DETAILS_LIMIT=50
GITHUB_CONTENT_MAX_BYTES=524288
GITHUB_DIFF_PATCH_MAX_CHARS=20000
IGNORE_BRANCHES=tmp/*
LOG_LEVEL=INFO
# Autenticacao centralizada do Modulo 1. O padrao e fail-closed.
MODULE1_AUTH_REQUIRED=true
MODULE1_AUTH_BASE_URL=https://mod1-auth.whitemeadow-deba1090.brazilsouth.azurecontainerapps.io
MODULE1_PROJECTS_BASE_URL=https://mod1-projects.whitemeadow-deba1090.brazilsouth.azurecontainerapps.io
MODULE1_JWT_ISSUER=https://mod1-auth.whitemeadow-deba1090.brazilsouth.azurecontainerapps.io
MODULE1_JWT_AUDIENCE=engenharia-software-api
MODULE1_JWKS_URL=https://mod1-auth.whitemeadow-deba1090.brazilsouth.azurecontainerapps.io/.well-known/jwks.json
MODULE1_HTTP_CONNECT_TIMEOUT=5
MODULE1_HTTP_READ_TIMEOUT=45
MODULE1_JWKS_TIMEOUT=15
MODULE1_JWKS_CACHE_SECONDS=300
PLATFORM_AUTH_THROTTLE_RATE=20/minute
# Enriquecimento opcional. O baseline deterministico funciona sem provedor externo.
AI_INSIGHTS_ENABLED=false
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=configured-model
AI_PROVIDER_TIMEOUT=15
