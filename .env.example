DEBUG=true
DJANGO_SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=github_sync
POSTGRES_USER=github_sync
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
GITHUB_API_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT=10
GITHUB_MAX_RETRY_AFTER=60
GITHUB_REQUIRED_SCOPES=
GITHUB_ALLOWED_SCOPES=repo,repo:status,read:org
GITHUB_COMMIT_DETAILS_LIMIT=50
IGNORE_BRANCHES=tmp/*
LOG_LEVEL=INFO
# Ative no ambiente compartilhado ate o JWT/RBAC do Modulo 1 ser integrado.
MODULE_ENFORCE_WRITE_AUTH=false
MODULE_API_KEY=
